{
  "title": "{{ .Site.Title }}",
  "generatedAt": "{{ now.Format "2006-01-02T15:04:05Z07:00" }}",
  "publicationsCount": {{ len (where .Site.RegularPages "Section" "publications") }},
  "authorsCount": {{ len (where .Site.RegularPages "Section" "authors") }},
  "publications": [
    {{ range $i, $p := where .Site.RegularPages "Section" "publications" }}
      {{ if $i }},{{ end }}
      {
        "title": {{ $p.Title | jsonify }},
        "path": {{ $p.RelPermalink | jsonify }},
        "year": {{ $p.Params.year | default 2026 }},
        "venue": {{ $p.Params.venue | jsonify }}
      }
    {{ end }}
  ],
  "authors": [
    {{ range $i, $a := where .Site.RegularPages "Section" "authors" }}
      {{ if $i }},{{ end }}
      {
        "name": {{ $a.Title | jsonify }},
        "path": {{ $a.RelPermalink | jsonify }},
        "role": {{ $a.Params.role | jsonify }}
      }
    {{ end }}
  ]
}
